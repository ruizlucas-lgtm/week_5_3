<Window x:Class="week_5_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:week_5_3"
        mc:Ignorable="d"
        Title="MainWindow" Height="1000" Width="450">
    <StackPanel Orientation="Vertical">
        <Label Content="First Name:" />
        <TextBox Name="txtFirstName" />
        <Label Content="Last Name:" />
        <TextBox Name="txtLastName" />
        <Button MaxWidth="200" Content="Enter" 
            Foreground="Aqua" Background="Purple" 
            FontSize="25" Margin="0,15,0,0"> </Button>
    </StackPanel>
</Window>
